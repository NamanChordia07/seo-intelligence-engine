# ---------------------------------------------------------------------------
# ATLAS configuration. Copy to `.env` and adjust. Never commit `.env`.
# Every value has a safe default so the demo runs with ZERO paid services.
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
ATLAS_ENV=development

# PostgreSQL (pgvector required). `python scripts/devstack.py up` serves this locally.
ATLAS_DATABASE_URL=postgresql+psycopg://atlas@127.0.0.1:5433/atlas
ATLAS_TEST_DATABASE_URL=postgresql+psycopg://atlas@127.0.0.1:5433/atlas_test

# Orchestrator: temporal | inline | auto
#   auto -> use Temporal when the server AND a worker are reachable, otherwise inline fallback.
ATLAS_ORCHESTRATOR=auto
ATLAS_TEMPORAL_ADDRESS=127.0.0.1:7233
ATLAS_TEMPORAL_NAMESPACE=default
ATLAS_TEMPORAL_TASK_QUEUE=atlas-main
ATLAS_TEMPORAL_UI_URL=http://127.0.0.1:8233

# Provider mode: demo | hybrid | live
#   demo   -> deterministic SIMULATED fixtures only (recommended for the walkthrough)
#   hybrid -> fixtures for scheduled demo days + optional live probes (autocomplete / SearXNG)
#   live   -> live public providers where configured, failing over gracefully
ATLAS_PROVIDER_MODE=demo

# Optional SearXNG instance for live SERP observation (leave blank to disable)
ATLAS_SEARXNG_URL=

# Allow fetching public web pages during research (respects robots.txt + SSRF guard)
ATLAS_LIVE_RESEARCH=false

# LLM provider: demo | ollama | openai
#   demo   -> deterministic fixture drafting (no model needed)
#   ollama -> local open-source model via Ollama's OpenAI-compatible endpoint
#   openai -> any OpenAI-compatible API (OPTIONAL; never required)
ATLAS_LLM_PROVIDER=demo
ATLAS_LLM_BASE_URL=http://127.0.0.1:11434/v1
ATLAS_LLM_MODEL=llama3.2:3b
ATLAS_LLM_API_KEY=
# Use the LLM only for advisory compliance review (deterministic rules stay authoritative)
ATLAS_LLM_ADVISORY_REVIEW=false

# Where generated Markdown articles are written
ATLAS_OUTPUT_DIR=outputs/articles

# CORS origins allowed to call the API (comma separated)
ATLAS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend -> API base URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
